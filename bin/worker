#!/bin/bash

CLASSPATH=$CLASSPATH:lib/*

if [ -z "$HEAP_OPTS" ]
then
    HEAP_OPTS="-Xms4G -Xmx4G"
fi

JVM_MEM="${HEAP_OPTS}"
JVM_OPTS="$JVM_OPTS --add-opens java.base/java.util.zip=ALL-UNNAMED"
exec java -server -cp $CLASSPATH $JVM_MEM $JVM_OPTS io.lakestream.streaming.proof.worker.WorkerStarter "$@"